# Variaveis do app web (Next.js). Copie para .env.local e preencha.
#   cp web/.env.example web/.env.local
#
# APENAS variaveis NEXT_PUBLIC_* podem ir para o cliente (vao para o bundle do
# navegador). Elas sao publicas por design: a anon key so libera o que o RLS
# permite. NUNCA coloque a service_role aqui nem em qualquer NEXT_PUBLIC_*.

# URL do projeto Supabase (publica)
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co

# Chave anonima (publica; protegida pelo RLS por familia)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui

# Chave da Groq, usada SO no servidor (rota /api/voz: transcricao Whisper +
# interpretacao da frase). Sem ela o ditado no app responde voz_indisponivel e a
# tela explica; o resto do app funciona igual. NUNCA prefixe com NEXT_PUBLIC_.
GROQ_API_KEY=sua_chave_groq_aqui
